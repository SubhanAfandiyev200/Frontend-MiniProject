<div class="w-full h-fit [background:var(--bg-gradient,var(--bg-color,var(--color-grey-200)))]">
  <div class="p-4 grid grid-cols-[2fr_1fr] gap-4 md:grid-cols-[1fr_2fr_1fr]">
    <header class="flex flex-col gap-2 self-center md:col-start-2 md:row-start-1 md:justify-self-center">
      <h2 class="text-3xl-serif xs:text-5xl-serif md:text-2xl-serif md:text-center text-[color:var(--color-text-brand)]">Sign up for new releases and subscriber exclusives</h2>
    </header>
    <div class="justify-self-end w-full -mr-4 -mt-8 md:mr-0 md:-my-4 md:col-start-1 md:row-start-1 md:row-span-2 md:self-end pointer-events-none" aria-hidden="true">
      <picture>
        <source media="(min-width: 768px)" sizes="25vw" srcset="https://bellroy-cms-images.imgix.net/2026-generic-slide-in-left.png?auto=format&amp;fit=max&amp;w=320 320w, https://bellroy-cms-images.imgix.net/2026-generic-slide-in-left.png?auto=format&amp;fit=max&amp;w=640 640w, https://bellroy-cms-images.imgix.net/2026-generic-slide-in-left.png?auto=format&amp;fit=max&amp;w=960 960w, https://bellroy-cms-images.imgix.net/2026-generic-slide-in-left.png?auto=format&amp;fit=max&amp;w=1280 1280w, https://bellroy-cms-images.imgix.net/2026-generic-slide-in-left.png?auto=format&amp;fit=max&amp;w=1920 1920w">
        <img class="block ml-auto w-full max-w-52 md:max-w-[300px]" alt="" loading="lazy" sizes="25vw" src="./signup-modal-thumb-1_files/2026-generic-slide-in-left.png" srcset="https://bellroy-cms-images.imgix.net/2026-generic-slide-in-left.png?auto=format&amp;fit=max&amp;w=320 320w, https://bellroy-cms-images.imgix.net/2026-generic-slide-in-left.png?auto=format&amp;fit=max&amp;w=640 640w, https://bellroy-cms-images.imgix.net/2026-generic-slide-in-left.png?auto=format&amp;fit=max&amp;w=960 960w, https://bellroy-cms-images.imgix.net/2026-generic-slide-in-left.png?auto=format&amp;fit=max&amp;w=1280 1280w, https://bellroy-cms-images.imgix.net/2026-generic-slide-in-left.png?auto=format&amp;fit=max&amp;w=1920 1920w">
      </picture>
    </div>
    <div class="justify-self-start self-start -mb-4 -mt-12 row-start-1 row-span-2 hidden md:block pointer-events-none" aria-hidden="true">
      <img class="block w-full max-w-[300px]" alt="" loading="lazy" sizes="25vw" src="./signup-modal-thumb-1_files/2026-generic-slide-in.png" srcset="https://bellroy-cms-images.imgix.net/2026-generic-slide-in.png?auto=format&amp;fit=max&amp;w=320 320w, https://bellroy-cms-images.imgix.net/2026-generic-slide-in.png?auto=format&amp;fit=max&amp;w=640 640w, https://bellroy-cms-images.imgix.net/2026-generic-slide-in.png?auto=format&amp;fit=max&amp;w=960 960w, https://bellroy-cms-images.imgix.net/2026-generic-slide-in.png?auto=format&amp;fit=max&amp;w=1280 1280w, https://bellroy-cms-images.imgix.net/2026-generic-slide-in.png?auto=format&amp;fit=max&amp;w=1920 1920w">
    </div>
    <div class="col-span-full flex flex-col gap-4 md:col-start-2 md:col-end-3 md:row-start-2 md:justify-self-center">
      <form class="group block w-full" action="https://manage.kmail-lists.com/subscriptions/subscribe" data-ajax-submit="//manage.kmail-lists.com/ajax/subscriptions/subscribe" id="NewsletterSlideInForm" method="GET" target="_blank" novalidate="" data-signup-source="slide_in">
        <input name="g" type="hidden" value="MnrA9u">
        <input name="$fields" type="hidden" value="$consent">
        <input name="$list_fields" type="hidden" value="$consent">
        <div class="flex gap-1 bg-white rounded shadow-button p-1 group-focus-within:shadow-pressed group-focus-within:ring-1 group-focus-within:ring-grey-300">
          <label class="sr-only" for="newsletter-slide-in-email">Enter your email address</label>
          <span class="sr-only" id="newsletter-slide-in-email-description">Subscribe to receive updates about new products and promotions</span>
          <input class="flex-1 p-2 border-none appearance-none text-base-sans text-grey-600 focus:border-0 focus:outline-none placeholder:text-grey-400 peer" aria-describedby="newsletter-slide-in-email-description" id="newsletter-slide-in-email" name="email" placeholder="Enter your email address" type="email" value="" required="">
          <button class="inline-flex p-2 rounded border-none appearance-none text-base-sans-bold-cta-uppercase text-white bg-grey-300 transition-colors group-focus-within:bg-orange peer-valid:bg-orange hover:bg-orange-dark" type="submit">
            Submit
          </button>
        </div>
        <div class="text-orange-dark text-base-sans text-center">
          <div class="success_message p-2 rounded bg-white mt-2" style="display:none;">Check your email for a confirmation message. Thanks for subscribing!</div>
          <div class="error_message p-2 rounded bg-white mt-2" style="display:none;">There was an error processing your request. Please try again later.</div>
        </div>
      </form>
      <p class="text-xs-sans-spaced text-center text-grey-400 link-inside:no-underline text-[color:var(--color-text-tertiary)] link-inside:text-[color:var(--link-color-text)]">You’re consenting to our <a href="https://bellroy.com/customer-care/privacy-policy" target="_blank">privacy policy</a> and signing up to receive emails which you can opt out of at any time.</p>
    </div>
  </div>
</div>

